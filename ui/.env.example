# ==============================================================================
# DAVID-Net UI — Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel: add each variable via Project Settings → Environment Variables.
# DO NOT commit .env.local — it is git-ignored.
# ==============================================================================


# ------------------------------------------------------------------------------
# REQUIRED — FastAPI backend URL
# ------------------------------------------------------------------------------
# Server-side (used by Next.js API route proxy in app/api/predict/route.ts).
# Must NOT have a trailing slash.
#
# Local dev:
#   API_URL=http://127.0.0.1:7860
#
# Production (Hugging Face Space — Pro T4):
API_URL=https://mohsinelis-david-net-av-v2.hf.space

# ------------------------------------------------------------------------------
# REQUIRED — Public FastAPI backend URL (client-side direct uploads)
# ------------------------------------------------------------------------------
# Used by lib/api.ts for large file uploads that bypass Vercel's 4.5 MB
# serverless payload limit by uploading directly from the browser to the backend.
# Must match API_URL exactly (same host, no trailing slash).
#
# Local dev:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:7860
#
# Production (Hugging Face Space — Pro T4):
NEXT_PUBLIC_API_URL=https://mohsinelis-david-net-av-v2.hf.space
